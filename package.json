{
  "name": "unireserva",
  "version": "1.0.0",
  "description": "Implementação inicial do sistema UniReserva com front-end e back-end.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test",
    "test:coverage": "node --test --coverage=coverage/",
    "lint": "eslint src/ test/ --max-warnings 0",
    "lint:fix": "eslint src/ test/ --fix",
    "db:init": "node scripts/initDb.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "pg-mem": "^3.0.5",
    "supertest": "^7.1.0"
  },
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HeloisaRebello17/UniReserva.git"
  },
